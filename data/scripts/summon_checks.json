    "pause_before_ms": 700,
    "expect": {
      "trigger": "SUMMON",
      "outcome": "answered",
      "note": "G12/L22: 2.0 GPA and 67% of attempted credits.",
      "refs": ["G12", "L22"]
    }
  },
  {
    "id": "q05",
